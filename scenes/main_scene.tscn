[connection signal="timeout" from="UI/Countdown/TimerDoor" to="." method="close_doors"]
[connection signal="timeout" from="UI/Countdown/TimerNextLevel" to="." method="train_arrive"]
[connection signal="animation_finished" from="Doors/DoorAnim" to="Doors/DoorAnim" method="stop" unbinds=1 binds= [true]]
